# Public site URL — used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.shriunityispat.com

# ---- Quote form delivery (configure ONE option) ----------------------------

# Option 1: Resend (https://resend.com) — recommended
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# QUOTE_FROM_EMAIL="Shri Unity Ispat Website <quotes@yourdomain.com>"   # must be a Resend-verified domain
# QUOTE_TO_EMAIL=shriunityispat.vns@gmail.com                           # optional, defaults to the business email

# Option 2: Formspree (https://formspree.io)
# FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# With neither set, the form still validates and offers one-tap
# WhatsApp / email hand-off with the enquiry pre-filled.
